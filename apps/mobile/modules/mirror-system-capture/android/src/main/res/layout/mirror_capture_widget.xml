<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/mirror_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/mirror_widget_background"
  android:clickable="true"
  android:focusable="true"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="14dp">

  <ImageView
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:contentDescription="@string/mirror_widget_capture"
    android:src="@android:drawable/ic_btn_speak_now" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/mirror_widget_title"
      android:textColor="#10201A"
      android:textSize="16sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="@string/mirror_widget_subtitle"
      android:textColor="#5E746A"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>

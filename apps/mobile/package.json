{
  "name": "@cognitive-mirror/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform ios --output-dir dist-ios && expo export --platform android --output-dir dist-android",
    "build:store": "eas build --profile production --platform all",
    "submit:store": "eas submit --profile production --platform all",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@cognitive-mirror/contracts": "workspace:*",
    "@expo/vector-icons": "15.1.1",
    "expo": "57.0.16",
    "expo-asset": "~57.0.14",
    "expo-audio": "57.0.4",
    "expo-background-task": "~57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-notifications": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-task-manager": "~57.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "^0.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "6.0.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
